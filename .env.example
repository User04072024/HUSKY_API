PORT=4000
NODE_ENV=development
# En producción usa el dominio principal: https://api.huskydev.space
PUBLIC_ORIGIN=http://localhost:4000

# Supabase Auth (Google/Gmail + GitHub)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_GOOGLE_EMAIL=creador@gmail.com
ADMIN_GITHUB_LOGIN=User04072024
# Activa Google y GitHub en Supabase Auth > Providers.
# En GitHub OAuth, usa el Client ID/Secret que entrega Supabase; no expongas el Secret en el frontend.

# En Supabase Auth > URL Configuration:
#   Site URL:      https://api.huskydev.space
#   Redirect URLs: https://api.huskydev.space/admin
#                  https://husky-api.vercel.app/admin
#                  http://localhost:4000/admin
# El login redirige a `${location.origin}/admin`, por eso cada dominio desde el que
# se use el panel debe estar en la lista de Redirect URLs.

# Long random value used to sign the HttpOnly admin session cookie
ADMIN_SESSION_SECRET=

# GitHub Contents API (required for admin commits in Vercel)
GITHUB_TOKEN=
GITHUB_OWNER=User04072024
GITHUB_REPO=HUSKY_API
GITHUB_BASE_BRANCH=main